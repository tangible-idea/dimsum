# 환경변수 템플릿.
#   cp .env.example .env
# 후 값을 채운다. .env는 .gitignore 대상이라 커밋되지 않는다.
#
# 주의: VITE_ 접두사 변수는 빌드 시 번들에 평문으로 박힌다.
# 여기 값은 "공개돼도 되는 권한"이어야 한다.

# Supabase 설정 (없으면 src/lib/supabase.js 의 기본값 사용)
VITE_SUPABASE_URL=https://ebpkbakjgzxfahsvrldk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# MQTT: EMQX Serverless (AWS 싱가포르). 브라우저는 WSS(8084, 경로 /mqtt).
# 기기(ESP32)는 같은 브로커의 8883을 쓰고 계정이 다르다 — 펌웨어 쪽 secrets.ini 참고.
# Supabase와 달리 기본값이 없다. 비어 있으면 앱이 즉시 예외를 던진다.
VITE_MQTT_WSS_URL=wss://nf071833.ala.asia-southeast1.emqxsl.com:8084/mqtt
VITE_MQTT_USERNAME=clickers_web
VITE_MQTT_PASSWORD=your-web-password
